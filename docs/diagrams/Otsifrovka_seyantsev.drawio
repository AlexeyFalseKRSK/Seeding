        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UC_Загрузка\nleft to right direction\n\nactor \&quot;Пользователь\&quot; as User\nactor \&quot;Система валидации\&quot; as Validator\n\nrectangle \&quot;Загрузка данных\&quot; {\n  usecase \&quot;UC1.1: Выбор файлов\&quot; as UC1_1\n  usecase \&quot;UC1.2: Проверка формата\&quot; as UC1_2\n  usecase \&quot;UC1.3: Конвертация PDF\&quot; as UC1_3\n  usecase \&quot;UC1.4: Генерация превью\&quot; as UC1_4\n  \n  User --&gt; UC1_1\n  UC1_1 --&gt; UC1_2\n  UC1_2 --&gt; UC1_3 : Если PDF\n  UC1_2 --&gt; UC1_4 : Если изображение\n  UC1_3 --&gt; UC1_4\n  Validator --&gt; UC1_2\n}\n\nnote right of UC1_2\n  &lt;b&gt;Поддерживаемые форматы:&lt;/b&gt;\n  • PDF (до 50 МБ)\n  • JPEG/PNG (до 20 МП)\nend note\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oSauc7KgcBDhWqG0LBva-227">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1000" y="2570" width="1167" height="282" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UC_Редактирование\nleft to right direction\n\nactor \&quot;Пользователь\&quot; as User\nactor \&quot;Система контроля версий\&quot; as VCS\n\nrectangle \&quot;Работа с масками\&quot; {\n  usecase \&quot;UC2.1: Открытие маски\&quot; as UC2_1\n  usecase \&quot;UC2.2: Ручная коррекция\&quot; as UC2_2\n  usecase \&quot;UC2.3: Сохранение версии\&quot; as UC2_3\n  usecase \&quot;UC2.4: Откат изменений\&quot; as UC2_4\n  \n  User --&gt; UC2_1\n  User --&gt; UC2_2 : Инструменты:\\n• Кисть\\n• Лассо\\n• Заливка\n  User --&gt; UC2_3\n  User --&gt; UC2_4\n  UC2_2 --&gt; UC2_3\n  VCS --&gt; UC2_3\n  VCS --&gt; UC2_4\n}\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oSauc7KgcBDhWqG0LBva-228">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1000" y="2880" width="792" height="327" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UC_Analysis\nleft to right direction\n\nactor \&quot;ML Система\&quot; as ML\nactor \&quot;Администратор моделей\&quot; as Admin\n\nrectangle \&quot;Анализ изображений\&quot; {\n  usecase \&quot;UC3.1: Предобработка\&quot; as UC3_1\n  usecase \&quot;UC3.2: Классификация\&quot; as UC3_2\n  usecase \&quot;UC3.3: Сегментация\&quot; as UC3_3\n  usecase \&quot;UC3.4: OCR обработка\&quot; as UC3_4\n  \n  ML --&gt; UC3_1\n  UC3_1 --&gt; UC3_2 : EfficientNetV2\n  UC3_1 --&gt; UC3_3 : U-Net\n  UC3_1 --&gt; UC3_4 : Tesseract\n  Admin --&gt; UC3_2 : Обновление моделей\n  Admin --&gt; UC3_3\n}\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oSauc7KgcBDhWqG0LBva-229">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1000" y="3228" width="702" height="341" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml UC_Отчет\nleft to right direction\n\nactor \&quot;Пользователь\&quot; as User\nactor \&quot;Система шаблонов\&quot; as Templates\n\nrectangle \&quot;Формирование отчёта\&quot; {\n  usecase \&quot;UC4.1: Выбор параметров\&quot; as UC4_1\n  usecase \&quot;UC4.2: Экспорт в Excel\&quot; as UC4_2\n  usecase \&quot;UC4.3: Генерация PDF\&quot; as UC4_3\n  \n  User --&gt; UC4_1\n  User --&gt; UC4_2\n  User --&gt; UC4_3\n  UC4_1 --&gt; UC4_2\n  UC4_1 --&gt; UC4_3\n  Templates --&gt; UC4_2\n  Templates --&gt; UC4_3\n}\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="oSauc7KgcBDhWqG0LBva-230">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1000" y="3600" width="617" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UC_Full_Decomposition\n\npackage \&quot;Основные процессы\&quot; {\n  [Загрузка данных] as UC1\n  [Анализ изображений] as UC2\n  [Работа с метками] as UC3\n  [Отчетность] as UC4\n}\n\npackage \&quot;Подпроцессы\&quot; {\n  [UC1.1 Выбор файлов] -- [UC1]\n  [UC1.2 Проверка формата] -- [UC1]\n  [UC3.2 Классификация] -- [UC2]\n  [UC3.3 Сегментация] -- [UC2]\n  [UC4.2 Excel] -- [UC4]\n}\n\nactor \&quot;Пользователь\&quot; as User\nactor \&quot;Администратор\&quot; as Admin\nactor \&quot;ML Система\&quot; as ML\n\nUser --&gt; [UC1]\nUser --&gt; [UC3]\nUser --&gt; [UC4]\nML --&gt; [UC2]\nAdmin --&gt; [Управление]\n\nnote right of [UC2]\n&lt;b&gt;Автоматические процессы:&lt;/b&gt;\n1. Предобработка\n2. Анализ\n3. Валидация\nend note\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oSauc7KgcBDhWqG0LBva-231">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1000" y="3960" width="1329" height="237" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
