        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml Система_оцифровки_растений\n\nleft to right direction\nskinparam monochrome true\nskinparam usecase {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  ArrowColor #000000\n}\n\nactor \&quot;Пользователь\&quot; as User #0058a3\nactor \&quot;Администратор\&quot; as Admin #0058a3\nactor \&quot;ML Система\&quot; as ML #0058a3\n\nrectangle \&quot;Система оцифровки растений\&quot; {\n  User --&gt; (Загрузка PDF/изображений)\n  User --&gt; (Редактирование масок)\n  User --&gt; (Просмотр истории изменений)\n  User --&gt; (Генерация отчёта)\n  User --&gt; (Настройка автосохранения)\n  \n  ML --&gt; (Классификация растения)\n  ML --&gt; (Сегментация элементов)\n  ML --&gt; (Измерение размеров)\n  ML --&gt; (OCR распознавание текста)\n  \n  Admin --&gt; (Управление пользователями)\n  Admin --&gt; (Очистка старых данных)\n}\n\nnote right of ML\n  &lt;b&gt;Автоматическая обработка&lt;/b&gt;\n  изображений\nend note\n\nnote left of Admin\n  &lt;b&gt;Права на управление&lt;/b&gt;\n  системой\nend note\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="oSauc7KgcBDhWqG0LBva-106">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="380" y="2290" width="607" height="938" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Компонентная_диаграмма_системы\n\nskinparam monochrome true\nskinparam componentStyle uml2\nskinparam nodesep 50\nskinparam ranksep 50\n\npackage \&quot;Настольное приложение\&quot; as App {\n  [GUI PyQt] as gui\n  [Редактор масок] as editor\n  [Менеджер отчётов] as reports\n}\n\npackage \&quot;Сервер\&quot; as Server {\n  [API FastAPI] as api\n  [Очередь задач] as queue\n}\n\npackage \&quot;ML Сервисы\&quot; as ML {\n  [Классификатор] as classifier\n  [Сегментатор] as segmenter\n  [OCR] as ocr\n}\n\npackage \&quot;Хранилище\&quot; as Storage {\n  [PostgreSQL] as db\n  [MinIO] as fs\n}\n\nApp --&gt; Server : HTTP\nServer --&gt; ML : gRPC\nServer --&gt; Storage : SQL\n\nnote right of App\n  &lt;b&gt;Настольное приложение&lt;/b&gt;\n  • PyQt для интерфейса\n  • Редактор масок\n  • Генерация отчётов\nend note\n\nnote left of ML\n  &lt;b&gt;ML компоненты&lt;/b&gt;\n  • Классификация растений\n  • Сегментация элементов\n  • Распознавание текста\nend note\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oSauc7KgcBDhWqG0LBva-107">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1350" y="1140" width="1158" height="575" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml IDEF1\ntitle Информационная модель (IDEF1)\n\nentity \&quot;Изображение\&quot; as image {\n  + id (PK)\n  ---\n  file_path\n  file_type\n  upload_date\n  thumbnail\n}\n\nentity \&quot;Анализ\&quot; as analysis {\n  + id (PK)\n  ---\n  plant_class\n  height_px\n  width_cm\n  analysis_date\n}\n\nentity \&quot;Маска\&quot; as mask {\n  + version (PK)\n  ---\n  mask_path\n  is_autosave\n  change_comment\n}\n\nentity \&quot;Отчёт\&quot; as report {\n  + id (PK)\n  ---\n  report_path\n  generation_date\n  parameters\n}\n\nimage ||-o{ analysis\nanalysis ||-o{ mask\nanalysis ||-o{ report\n\nnote top of image: Исходные данные\\n(PDF/JPG/PNG)\nnote bottom of analysis: Результаты\\nML-обработки\nnote right of mask: История версий\\nсегментации\nnote left of report: Экспортные данные\\nв Excel/PDF\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oSauc7KgcBDhWqG0LBva-113">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="2080" y="1788.5" width="895" height="367" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ER_Diagram\ntitle ER-диаграмма базы данных системы оцифровки растений\n\nskinparam linetype ortho\nskinparam packageStyle rectangle\nhide circle\n\nentity \&quot;Пользователь\&quot; as user {\n  + user_id (PK) &lt;&lt;autoincrement&gt;&gt;\n  --\n  username : varchar(50) &lt;&lt;unique&gt;&gt;\n  password_hash : varchar(255)\n  email : varchar(100) &lt;&lt;unique&gt;&gt;\n  role : enum(&#39;user&#39;,&#39;admin&#39;)\n  created_at : timestamp\n}\n\nentity \&quot;Изображение\&quot; as image {\n  + image_id (PK) &lt;&lt;autoincrement&gt;&gt;\n  --\n  # user_id (FK)\n  original_path : varchar(255)\n  thumbnail_path : varchar(255)\n  file_type : enum(&#39;pdf&#39;,&#39;jpg&#39;,&#39;png&#39;)\n  upload_date : timestamp\n  status : enum(&#39;uploaded&#39;,&#39;processed&#39;)\n}\n\nentity \&quot;Анализ\&quot; as analysis {\n  + analysis_id (PK) &lt;&lt;autoincrement&gt;&gt;\n  --\n  # image_id (FK)\n  plant_class : varchar(100)\n  confidence : decimal(5,2)\n  height_px : integer\n  width_px : integer\n  analyzed_at : timestamp\n}\n\nentity \&quot;Маска\&quot; as mask {\n  + mask_id (PK) &lt;&lt;autoincrement&gt;&gt;\n  --\n  # analysis_id (FK)\n  # editor_id (FK)\n  version : integer\n  mask_path : varchar(255)\n  is_autosave : boolean\n  change_comment : text\n  created_at : timestamp\n}\n\nentity \&quot;Текст\&quot; as text {\n  + text_id (PK) &lt;&lt;autoincrement&gt;&gt;\n  --\n  # analysis_id (FK)\n  content : text\n  bounding_box : json\n  confidence : decimal(5,2)\n}\n\nentity \&quot;Отчет\&quot; as report {\n  + report_id (PK) &lt;&lt;autoincrement&gt;&gt;\n  --\n  # user_id (FK)\n  report_path : varchar(255)\n  format : enum(&#39;excel&#39;,&#39;pdf&#39;)\n  generated_at : timestamp\n  parameters : json\n}\n\n&#39; Связи\nuser ||--o{ image : \&quot;Загружает\&quot;\nimage ||--|| analysis : \&quot;Содержит\&quot;\nanalysis ||--o{ mask : \&quot;Имеет версии\&quot;\nanalysis ||--o{ text : \&quot;Содержит текст\&quot;\nuser ||--o{ report : \&quot;Генерирует\&quot;\nmask }|--|| user : \&quot;Редактировал\&quot;\n\n&#39; Индексы\nnote bottom of analysis\n  Индексы:\n  idx_plant_class (plant_class)\n  idx_analysis_date (analyzed_at)\nend note\n\nnote right of image\n  Хранение:\n  • Оригиналы - MinIO/S3\n  • Превью - локально\nend note\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oSauc7KgcBDhWqG0LBva-114">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
